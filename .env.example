# Trading Bot Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!

# =============================================================================
# BINANCE API CREDENTIALS
# =============================================================================

# Testnet API Keys (for development/testing)
# Get your testnet keys at: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Production API Keys (for live trading)
# Get your keys at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_production_api_key_here
BINANCE_API_SECRET=your_production_api_secret_here

# =============================================================================
# BOT CONFIGURATION
# =============================================================================

# Trading mode: "testnet" or "production"
TRADING_MODE=testnet

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Database path (default: data/trading_bot.db)
# DATABASE_PATH=data/trading_bot.db

# Dashboard port (default: 8050)
# DASHBOARD_PORT=8050
